# --- Core ---
APP_ENV=dev                        # Environment: dev | prod
DATABASE_URL=postgresql://postgres:asdasdasdasddsger34@db.nwyqdztrxdzzybfevdpe.supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me               # Secret key for session signing
OPERATOR_PASSWORD=change-me        # Password for the single operator account
BASE_URL=http://localhost:8000     # Base URL for building unsubscribe/click links

# --- LLM ---
LLM_BASE_URL=https://openrouter.ai/api/v1   # OpenAI-compatible endpoint
LLM_API_KEY=                                 # API key for LLM provider
PLANNER_MODEL=nousresearch/hermes-4-405b     # Model for campaign planning, copywriting
WORKER_MODEL=nousresearch/hermes-4-70b       # Model for reply classification, personalization
LLM_MAX_TOOL_ITERATIONS=12                   # Maximum tool iterations for agent loop
LLM_TIMEOUT_SECONDS=120                      # Timeout in seconds for LLM requests

# --- Email provider ---
EMAIL_PROVIDER=mock                # Email provider: mock | resend
RESEND_API_KEY=                    # Resend API key (required when EMAIL_PROVIDER=resend)
RESEND_WEBHOOK_SECRET=             # Resend webhook secret for signature verification
FROM_NAME=Hermes                   # Sender name for ouatgoing emails
FROM_EMAIL=hello@mail.example.com  # Sender email address (must be on authenticated domain)
REPLY_TO_EMAIL=replies@mail.example.com
COMPANY_POSTAL_ADDRESS="Acme Pvt Ltd, 1 Example Road, Lucknow, UP 226001, India"

# --- Inbound (IMAP) ---
IMAP_HOST=                         # IMAP server host for inbound email polling
IMAP_PORT=993                      # IMAP server port (default 993 for SSL)
IMAP_USER=                         # IMAP username for inbound email polling
IMAP_PASSWORD=                     # IMAP password for inbound email polling
IMAP_FOLDER=INBOX                  # IMAP folder to poll for inbound emails
INBOUND_POLL_SECONDS=120           # Interval in seconds between IMAP polls

# --- Guardrails (hard caps; dispatcher reads these) ---
MAX_SENDS_PER_DAY=500              # Maximum emails per 24-hour period
MAX_SENDS_PER_HOUR=100             # Maximum emails per 1-hour period
MAX_EMAILS_PER_CONTACT_PER_WEEK=3  # Maximum emails per contact per 7-day period
QUIET_HOURS_START=21               # Start hour of quiet hours (24h format, contact-local time)
QUIET_HOURS_END=8                  # End hour of quiet hours (24h format, contact-local time)
AUTO_PAUSE_BOUNCE_RATE=0.02        # Auto-pause threshold for bounce rate (rolling 24h)
AUTO_PAUSE_COMPLAINT_RATE=0.001    # Auto-pause threshold for complaint rate (rolling 24h)
REQUIRE_APPROVAL_FOR_SENDS=true    # Require human approval before sending emails